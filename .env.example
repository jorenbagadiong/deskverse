# Deskverse local configuration template (DV-004A).
#
# Copy to .env.local (never commit .env.local) and replace REPLACE_ME, or
# let `bash scripts/db/setup-local.sh` create .env.local with random
# passwords for you. Keep it private: chmod 600 .env.local
#
# Server-side only: never prefix these with NEXT_PUBLIC_.
#
# PostgreSQL is only needed for Affiliate Tickets (DV-004B onwards). Pixel
# Studio and the office work without it.

# Development database (the app, yarn db:migrate, yarn db:backup).
# Must point at 127.0.0.1; no ?options.
DATABASE_URL=postgresql://deskverse_app:REPLACE_ME@127.0.0.1:5432/deskverse

# Test database (yarn test:db only). A separate role and database: tests
# never read DATABASE_URL.
DATABASE_TEST_URL=postgresql://deskverse_test:REPLACE_ME@127.0.0.1:5432/deskverse_test

# Optional: keep Deskverse's data (Pixel Studio jobs, ticket media and
# ticket videos) somewhere other than ~/.local/share/deskverse (absolute
# path, outside the repository). The app and `yarn worker:start` must use
# the same folder: it also holds the render lock that keeps FFmpeg renders
# one at a time (DV-005C).
# DESKVERSE_DATA_DIR=

# Scout research (DV-005A). Off by default: nothing is fetched until you
# set this to "on" (then restart the app and the worker). Scout reads only
# the reference URLs you add to products, never affiliate links.
# DESKVERSE_SCOUT_RETRIEVAL=on

# Optional local model for extra extraction (never a hosted model; Scout
# never downloads one). Loopback addresses only.
# DESKVERSE_SCOUT_EXTRACTION=ollama
# DESKVERSE_SCOUT_OLLAMA_URL=http://127.0.0.1:11434
# DESKVERSE_SCOUT_OLLAMA_MODEL=REPLACE_WITH_AN_INSTALLED_MODEL

# Quill scriptwriting (DV-005B) uses templates by default (no AI model).
# Optional local model wording, loopback only, a model you installed:
# DESKVERSE_QUILL_GENERATION=ollama
# DESKVERSE_QUILL_OLLAMA_URL=http://127.0.0.1:11434
# DESKVERSE_QUILL_OLLAMA_MODEL=REPLACE_WITH_AN_INSTALLED_MODEL
