{
  "name": "deskverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "check": "yarn lint && yarn typecheck && yarn format:check && yarn test",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --import ./scripts/server-only-hook.mjs scripts/db/migrate.ts",
    "db:check": "tsx --import ./scripts/server-only-hook.mjs scripts/db/check.ts",
    "db:backup": "tsx --import ./scripts/server-only-hook.mjs scripts/db/backup.ts",
    "db:backup:verify": "tsx --import ./scripts/server-only-hook.mjs scripts/db/verify-backup.ts",
    "db:restore": "tsx --import ./scripts/server-only-hook.mjs scripts/db/restore.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@next/env": "16.4.6",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "yarn@4.18.0"
}
